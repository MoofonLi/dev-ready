protocol_version: 1

roles:
  ceo:
    title: Project Owner
    model: null
    responsibilities:
      - Set goals and accept durable specs.
      - Approve ticket breakdowns and merge completed work.
    never_does:
      - Delegate final commit or merge authority outside the scoped release exception.
  tech_lead:
    title: Architecture Lead
    model: null
    responsibilities:
      - Own planning, architecture decisions, and accepted specs.
{{tech_lead_architecture_responsibility}}
    never_does:
      - Write or edit implementation code.
  senior_engineer:
    title: Dispatch and Review Lead
    model: null
    responsibilities:
      - Dispatch tracer-bullet tickets from accepted specs.
      - Review completed implementation against the spec and architecture.
      - Resolve hard bugs escalated by execution.
    never_does:
      - Take implementation work that fits the execution role.
  junior_engineer:
    title: Execution Engineer
    model: null
    responsibilities:
      - Implement one frontier ticket at a time inside its file footprint.
      - Use test-driven development and write the phase execution report.
    never_does:
      - Run state-changing Git commands.
      - Expand a ticket footprint or grind on a hard bug.
  qa_reviewer:
    title: Quality Reviewer
    model: null
    responsibilities:
      - Run the independent functional-quality gate.
    never_does:
      - Modify implementation code while reviewing.
  security_reviewer:
    title: Security Reviewer
    model: null
    responsibilities:
      - Run the independent security gate.
    never_does:
      - Modify implementation code while reviewing.
  sre_reviewer:
    title: Reliability Reviewer
    model: null
    responsibilities:
      - Run the independent operability and failure-behavior gate.
    never_does:
      - Modify implementation code while reviewing.

handoff_sequence:
  - ceo
  - tech_lead
  - senior_engineer
  - junior_engineer
  - senior_engineer
  - qa_reviewer
  - security_reviewer
  - sre_reviewer
  - ceo

rules:
  stop_rule: junior_engineer stops after a hard bug or required work outside the current ticket footprint.
  escalation_rule: junior_engineer records the blocker in reports/problems.md; senior_engineer owns diagnosis and resolution before verification continues.
  reporting_rule: junior_engineer always updates reports/execution-report.md with per-ticket results and test evidence.
  commit_authority: ceo alone may commit, branch, push, or merge; only an explicit release step may declare a scoped exception.

artifacts:
  specs: docs/specs/
  tickets: docs/handoffs/phase-N/tickets/
  execution_report: docs/handoffs/phase-N/reports/execution-report.md
  problems_report: docs/handoffs/phase-N/reports/problems.md
  review_gates:
    - docs/handoffs/phase-N/03-review.md
    - docs/handoffs/phase-N/04-qa-review.md
    - docs/handoffs/phase-N/05-security-review.md
    - docs/handoffs/phase-N/06-sre-review.md
