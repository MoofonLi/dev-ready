              "src": "claude/skills/security-audit",
              "dest": ".agents/skills/security-audit"
            }
          ]
        },
        {
          "id": "spec-loop",
          "kind": "development-loop",
          "category": "dev",
          "description": "Complete Spec Loop for grilling, durable specs, tracer-bullet tickets, TDD, review, diagnosis, and architecture improvement.",
          "mode": "vendor",
          "license": "MIT",
          "vendored_repo": "mattpocock/skills",
          "steps": [
            "grill-with-docs",
            "grilling",
            "domain-modeling",
            "to-spec",
            "to-tickets",
            "implement",
            "tdd",
            "diagnosing-bugs",
            "code-review",
            "improve-codebase-architecture",
            "codebase-design",
            "setup-matt-pocock-skills"
          ],
          "paths": [
            {
              "src": "claude/skills/tdd",
              "dest": ".agents/skills/tdd"
            },
            {
              "src": "claude/skills/diagnosing-bugs",
              "dest": ".agents/skills/diagnosing-bugs"
