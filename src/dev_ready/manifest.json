      "items": [
        {
          "id": "code-memory",
          "category": "token-optimize",
          "description": "Codebase-memory MCP server (DeusData/codebase-memory-mcp), launched on demand via uvx.",
          "mode": "pinned-dependency",
          "license": "MIT",
          "pin": "0.9.0",
          "inject": {
            "kind": "mcp-server",
            "target": ".mcp.json",
            "server_name": "codebase-memory",
            "command": "uvx",
            "package": "codebase-memory-mcp"
          }
        }
      ]
