      "items": [
        {
          "id": "design-stripe",
          "category": "design",
          "mount": "implement",
          "description": "Stripe-inspired DESIGN.md reference for a polished light interface system; omit it if that visual direction is not useful.",
          "mode": "vendor",
          "license": "MIT",
          "vendored_repo": "VoltAgent/awesome-design-md",
          "paths": [
            {
              "src": "docs/design-stripe.md",
