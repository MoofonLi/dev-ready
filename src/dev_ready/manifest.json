  "components": {
    "skills": {
      "items": [
        {
          "id": "react-doctor",
          "category": "quality",
          "mount": "code-review",
          "description": "Wrapper skill teaching the agent when to run react-doctor on the frontend and how to act on its findings.",
          "mode": "pinned-dependency",
          "license": "MIT",
          "pin": "0.8.1",
          "paths": [
            {
              "src": "claude/skills/react-doctor",
              "dest": ".agents/skills/react-doctor"
            }
          ],
          "inject": {
            "kind": "npm-dev-dependency",
            "target": "frontend/package.json",
            "package": "react-doctor",
            "scripts": {
              "doctor": "react-doctor"
            }
          }
        },
        {
          "id": "caveman",
          "category": "token-optimize",
          "description": "Token-discipline and concise response guidance for AI coding agents.",
          "mode": "vendor",
          "license": "MIT",
          "vendored_repo": "JuliusBrussee/caveman",
          "paths": [
