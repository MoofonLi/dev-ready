{
  "manifest_version": 1,
  "default_set": {
    "development_loop": "spec-loop",
    "enhancements": []
  },
  "categories": {
    "dev": {
      "description": "Development methods for planning, implementation, and review."
    },
    "security": {
      "description": "Tools for finding and reducing security risks."
    },
    "quality": {
      "description": "Tools for testing behavior and reviewing implementation quality."
    },
    "design": {
      "description": "Tools and references for polished interfaces and design systems."
    },
    "token-optimize": {
      "description": "Tools that reduce agent context use and improve codebase recall."
    }
  },
  "agent_targets": {
    "claude": {
      "description": "Claude Code native project configuration.",
      "skills_dir": ".claude/skills",
      "rules_file": "CLAUDE.md",
      "mcp_file": ".mcp.json"
    },
    "windsurf": {
      "description": "Windsurf native project skill discovery.",
      "skills_dir": ".windsurf/skills",
      "rules_file": null,
      "mcp_file": null
    }
  },
  "upstream": {
    "base_template": {
      "repo": "fastapi/full-stack-fastapi-template",
      "ref": "master",
      "commit": "5b358ea6f422a09cc0d6f75c4164cf8a36005c4c",
      "verified_at": "2026-07-27",
      "license": "MIT",
      "exclude": [
        ".git",
        "copier.yml",
        "copier.yaml",
        ".agents/skills/fastapi",
        ".agents/skills/sqlmodel",
        ".claude/skills/fastapi",
        ".claude/skills/sqlmodel"
      ],
      "prune": [
        ".github/workflows/deploy-production.yml",
        ".github/workflows/deploy-staging.yml",
        ".github/workflows/issue-manager.yml",
        ".github/workflows/labeler.yml",
        ".github/workflows/add-to-project.yml",
        ".github/workflows/latest-changes.yml",
        ".github/workflows/smokeshow.yml",
        ".github/workflows/detect-conflicts.yml",
        ".github/workflows/zizmor.yml",
        ".github/workflows/guard-dependencies.yml",
        ".github/labeler.yml",
        "CONTRIBUTING.md",
        "release-notes.md",
        "/README.md",
        "img/**",
        "scripts/add_latest_release_date.py",
        "hooks/**"
      ]
    }
  },
