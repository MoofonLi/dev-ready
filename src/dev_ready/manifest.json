            },
            {
              "src": "claude/skills/to-spec",
              "dest": ".agents/skills/to-spec"
            },
            {
              "src": "claude/skills/to-tickets",
              "dest": ".agents/skills/to-tickets"
            },
            {
              "src": "claude/skills/implement",
              "dest": ".agents/skills/implement"
            },
            {
              "src": "claude/skills/improve-codebase-architecture",
              "dest": ".agents/skills/improve-codebase-architecture"
            },
            {
              "src": "claude/skills/codebase-design",
              "dest": ".agents/skills/codebase-design"
            },
            {
              "src": "claude/skills/setup-matt-pocock-skills",
              "dest": ".agents/skills/setup-matt-pocock-skills"
            },
            {
              "src": "claude/spec-loop",
              "dest": "docs/agents"
            }
          ]
        },
        {
          "id": "webapp-testing",
          "category": "quality",
          "mount": "tdd",
          "description": "Browser-automation skill for testing web apps end-to-end \u2014 drives a headless browser to exercise UI flows, capture console logs, and discover elements. Vendored from anthropics/skills (Apache-2.0).",
          "mode": "vendor",
          "license": "Apache-2.0",
          "vendored_repo": "anthropics/skills",
          "paths": [
            {
              "src": "claude/skills/webapp-testing",
              "dest": ".agents/skills/webapp-testing"
            }
          ]
        },
        {
          "id": "frontend-design",
          "category": "design",
          "mount": "implement",
          "description": "Methodology skill for how to build high-quality frontend UI \u2014 layout, spacing, visual hierarchy, and interaction polish. Distinct from the awesome-design-md DESIGN.md reference templates in the docs component (which show what good design systems like Stripe and Linear look like): this is the how-to process, those are the what-good-looks-like references. Vendored from anthropics/skills (Apache-2.0).",
          "mode": "vendor",
          "license": "Apache-2.0",
          "vendored_repo": "anthropics/skills",
          "paths": [
            {
              "src": "claude/skills/frontend-design",
              "dest": ".agents/skills/frontend-design"
            }
          ]
        }
